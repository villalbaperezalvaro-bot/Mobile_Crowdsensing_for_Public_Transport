<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp">

    <!-- 1. Eliminamos el primer TextView que no se usa -->

    <!-- 2. Usamos estilos para mejor apariencia -->
    <com.google.android.material.textfield.TextInputLayout
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Ruta"
        android:layout_marginBottom="12dp">

        <AutoCompleteTextView
            android:id="@+id/dialogSpinnerRuta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="text" />

    </com.google.android.material.textfield.TextInputLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Número de Unidad:"
        style="@style/TextAppearance.AppCompat.Caption"/>

    <!-- 3. CORRECCIÓN PRINCIPAL: Spinner -> EditText -->
    <EditText
        android:id="@+id/dialogEditUnidad"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Ej. 123"
        android:inputType="textCapCharacters"
        android:layout_marginBottom="16dp"/>

    <com.google.android.material.textfield.TextInputLayout
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Tipo de transporte">

        <AutoCompleteTextView
            android:id="@+id/dialogSpinnerTipoTransp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="text" />

    </com.google.android.material.textfield.TextInputLayout>

</LinearLayout>
